<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>StoreKeys.Cli</RootNamespace>

    <!-- No AssemblyName override: naming the exe "storekeys" collides with the StoreKeys
         library project and makes solution-level project references ambiguous. -->
    <AssemblyName>StoreKeys.Cli</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\StoreKeys\StoreKeys.csproj" />
  </ItemGroup>

</Project>
